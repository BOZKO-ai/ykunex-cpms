# Copy this file to ".env" before running. Dummy/dev values only.
# MySQL format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://cpms_user:change-me@localhost:3306/yakunex_cpms"
# Used to sign login cookies. Replace with a long random string for any real use:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
# Set to "true" only when serving over HTTPS
COOKIE_SECURE="false"
